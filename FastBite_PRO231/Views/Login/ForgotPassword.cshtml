@model FastBite_PRO231.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Quên mật khẩu";
}

<section class="fb-auth-page">
    <div class="container">
        <div class="fb-auth-card">
            <div class="fb-auth-title">
                <img src="~/images/fastbite-logo.jpg"
                     asp-append-version="true"
                     alt="FastBite Logo" />

                <h1>Quên mật khẩu</h1>

                <p>
                    Nhập email đã đăng ký, chúng tôi sẽ gửi mã xác thực (OTP) đến email của bạn.
                </p>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    @TempData["Success"]
                </div>
            }

            <form asp-controller="Login" asp-action="ForgotPassword" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3 fw-bold">
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="fb-form-label"></label>

                    <input asp-for="Email"
                           type="email"
                           class="form-control fb-form-control"
                           placeholder="Nhập email đã đăng ký"
                           autocomplete="email" />

                    <span asp-validation-for="Email"
                          class="text-danger fb-validation">
                    </span>
                </div>

                <button type="submit" class="btn fb-btn-primary w-100 mt-2">
                    Gửi mã OTP
                </button>

                <div class="text-center mt-4">
                    <p class="mb-0">
                        Nhớ mật khẩu rồi?
                        <a asp-controller="Login"
                           asp-action="Login"
                           class="fb-auth-link">
                            Quay lại đăng nhập
                        </a>
                    </p>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}