@using System
@using Microsoft.AspNetCore.Http
@model FastBite_PRO231.ViewModels.InventoryManagementFormViewModel

@{
    ViewData["Title"] = "Tạo tồn kho";

    var role =
        Context.Session.GetString("Role")
        ?? "";

    if (string.Equals(
            role,
            "Admin",
            StringComparison.OrdinalIgnoreCase))
    {
        Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_EmployeeLayout.cshtml";
    }
}

<section class="fbinv-page">

    <div class="fbinv-header">
        <div>
            <p>TẠO TỒN KHO</p>

            <h1>Thêm sản phẩm vào kho</h1>

            <span>
                Chỉ hiển thị những sản phẩm chưa có bản ghi tồn kho.
            </span>
        </div>

        <a asp-controller="Inventories"
           asp-action="Index"
           class="fbinv-secondary-button">

            ← Quay lại
        </a>
    </div>

    <section class="fbinv-form-card">
        <div class="fbinv-panel-heading">
            <div>
                <p>THÔNG TIN KHO</p>

                <h2>Tạo bản ghi mới</h2>
            </div>
        </div>

        @if (Model.Products.Count == 0)
        {
            <div class="fbinv-empty">
                <div>✅</div>

                <h3>Tất cả sản phẩm đã có tồn kho</h3>

                <p>
                    Không còn sản phẩm nào để tạo thêm bản ghi kho.
                </p>

                <a asp-controller="Inventories"
                   asp-action="Index">

                    Xem danh sách tồn kho
                </a>
            </div>
        }
        else
        {
            <form asp-controller="Inventories"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="ProductId"
                               class="form-label fw-bold">
                        </label>

                        <select asp-for="ProductId"
                                class="form-select">

                            <option value="0">
                                -- Chọn sản phẩm --
                            </option>

                            @foreach (var product in Model.Products)
                            {
                                if (Model.ProductId == product.ProductId)
                                {
                                    <option value="@product.ProductId"
                                            selected>

                                        @product.ProductName
                                        · @product.CategoryName
                                        · @product.Price.ToString("N0")đ
                                    </option>
                                }
                                else
                                {
                                    <option value="@product.ProductId">

                                        @product.ProductName
                                        · @product.CategoryName
                                        · @product.Price.ToString("N0")đ
                                    </option>
                                }
                            }
                        </select>

                        <span asp-validation-for="ProductId"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Quantity"
                               class="form-label fw-bold">
                        </label>

                        <input asp-for="Quantity"
                               type="number"
                               min="0"
                               class="form-control"
                               placeholder="Nhập số lượng ban đầu" />

                        <span asp-validation-for="Quantity"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Unit"
                               class="form-label fw-bold">
                        </label>

                        <input asp-for="Unit"
                               class="form-control"
                               placeholder="Ví dụ: Phần, Cái, Hộp..." />

                        <span asp-validation-for="Unit"
                              class="text-danger">
                        </span>
                    </div>
                </div>

                <div class="fbinv-form-note">
                    Mỗi sản phẩm chỉ có một bản ghi tồn kho. Sau khi tạo,
                    bạn có thể nhập hoặc xuất kho tại trang chi tiết.
                </div>

                <div class="fbinv-form-actions">
                    <button type="submit"
                            class="fbinv-primary-button"
                            onclick="return confirm('Xác nhận tạo tồn kho cho sản phẩm này?')">

                        Lưu tồn kho
                    </button>

                    <a asp-controller="Inventories"
                       asp-action="Index"
                       class="fbinv-secondary-button">

                        Hủy
                    </a>
                </div>
            </form>
        }
    </section>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}