@model FastBite_PRO231.ViewModels.CheckoutViewModel

@{
    ViewData["Title"] = "Xác nhận đơn hàng";
}

<link rel="stylesheet"
      href="https://unpkg.com/leaflet/dist/leaflet.css" />

<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>

<section class="fbco-page">
    <div class="container">
        <div class="fbco-header">
            <div>
                <p>✅ XÁC NHẬN ĐƠN HÀNG</p>

                <h1>Hoàn tất đặt món</h1>

                <span>
                    Kiểm tra thông tin và danh sách món trước khi xác nhận.
                </span>
            </div>

            <a asp-controller="Cart"
               asp-action="Index"
               class="fbco-back-button">
                ← Quay lại giỏ hàng
            </a>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <form asp-controller="Checkout"
              asp-action="PlaceOrder"
              method="post">

            @Html.AntiForgeryToken()
            @foreach (var id in Model.SelectedCartItemIds)
            {
                <input type="hidden" name="SelectedCartItemIds" value="@id" />
            }

            <div class="fbco-grid">
                <div class="fbco-left">
                    <section class="fbco-card">
                        <h2>Thông tin khách hàng</h2>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="FullName" class="form-label fw-bold"></label>
                                <input asp-for="FullName" class="form-control" />
                                <span asp-validation-for="FullName" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label fw-bold"></label>
                                <input asp-for="Phone" class="form-control" />
                                <span asp-validation-for="Phone" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-bold"></label>
                                <input asp-for="Email" type="email" class="form-control" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <span asp-validation-for="Address" class="text-danger"></span>
                            <small class="text-muted d-block mt-1">
                                📍 Chọn vị trí trên bản đồ để tính phí ship chính xác theo khoảng cách (không bắt buộc).
                            </small>
                            <div id="searchResult" class="list-group mt-1"></div>

                            <div class="col-12">
                                <label asp-for="Address" class="form-label fw-bold">
                                    Địa chỉ giao hàng
                                </label>

                                <input asp-for="Address"
                                       id="address"
                                       class="form-control"
                                       autocomplete="off"
                                       placeholder="Nhập địa chỉ..." />

                                <div id="searchResult" class="list-group mt-1"></div>

                                <input type="hidden" id="Latitude" name="Latitude" />
                                <input type="hidden" id="Longitude" name="Longitude" />

                                <div id="map"
                                     style="height:350px;margin-top:15px;border-radius:10px;"></div>
                            </div>
                        </div>
                    </section>

                    <section class="fbco-card">
                        <h2>Món trong đơn hàng</h2>

                        <div class="fbco-item-list">
                            @foreach (var item in Model.Items)
                            {
                                <article class="fbco-item">
                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl"
                                             alt="@item.ProductName"
                                             class="fbco-item-image" />
                                    }
                                    else
                                    {
                                        <div class="fbco-item-placeholder">
                                            🍔
                                        </div>
                                    }

                                    <div class="fbco-item-info">
                                        <strong>
                                            @item.ProductName
                                        </strong>

                                        <span>
                                            @item.Quantity ×
                                            @item.UnitPrice.ToString("N0")đ
                                        </span>
                                    </div>

                                    <strong class="fbco-item-total">
                                        @item.SubTotal.ToString("N0")đ
                                    </strong>
                                </article>
                            }
                        </div>
                    </section>

                    <section class="fbco-card">
                        <h2>Phương thức thanh toán</h2>

                        <div class="d-flex flex-column gap-2 mt-2">
                            <label class="border rounded-3 p-3 d-flex align-items-center gap-3
                                @(Model.PaymentMethod != "VNPay" ? "border-danger bg-light" : "")">

                                <input type="radio"
                                       asp-for="PaymentMethod"
                                       value="COD"
                                       class="form-check-input mt-0"
                                       checked="@(Model.PaymentMethod != "VNPay")" />

                                <span class="fs-4">💵</span>

                                <div>
                                    <div class="fw-bold">Thanh toán trực tiếp (COD)</div>
                                    <div class="text-muted small">Trả tiền mặt cho shipper khi nhận hàng</div>
                                </div>
                            </label>

                            <label class="border rounded-3 p-3 d-flex align-items-center gap-3
                                @(Model.PaymentMethod == "VNPay" ? "border-danger bg-light" : "")">

                                <input type="radio"
                                       asp-for="PaymentMethod"
                                       value="VNPay"
                                       class="form-check-input mt-0"
                                       checked="@(Model.PaymentMethod == "VNPay")" />

                                <span class="fs-4">💳</span>

                                <div>
                                    <div class="fw-bold">Ví điện tử VNPay</div>
                                    <div class="text-muted small">Thanh toán online qua thẻ ATM/QR</div>
                                </div>
                            </label>
                        </div>

                        <span asp-validation-for="PaymentMethod" class="text-danger d-block mt-2"></span>
                    </section>

                    <section class="fbco-card">
                        <h2>Ghi chú cho cửa hàng</h2>

                        <textarea asp-for="Note"
                                  class="form-control mt-2"
                                  rows="3"
                                  placeholder="Ví dụ: không lấy hành, giao giờ trưa..."></textarea>
                    </section>
                </div>

                <aside class="fbco-summary">
                    <h2>Tóm tắt đơn hàng</h2>

                    <div class="fbco-summary-row">
                        <span>Tổng số lượng</span>

                        <strong>
                            @Model.TotalQuantity phần
                        </strong>
                    </div>

                    <div class="fbco-summary-row">
                        <span>Phí giao hàng</span>
                        <strong>0đ</strong>
                    </div>

                    <div class="fbco-summary-total">
                        <span>Tổng thanh toán</span>

                        <strong>
                            @Model.TotalAmount.ToString("N0")đ
                        </strong>
                    </div>

                    <button type="submit"
                            class="fbco-order-button"
                            onclick="return confirm('Xác nhận đặt đơn hàng này?')">
                        Xác nhận đặt hàng
                    </button>

                    <p class="fbco-note">
                        Đơn hàng sẽ chuyển sang trạng thái
                        “Đang chờ xử lý”.
                    </p>
                </aside>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Toạ độ mặc định (tạm để trung tâm TP.HCM) -
            // NÊN THAY bằng toạ độ THẬT của cửa hàng FastBite để bản đồ mở đúng vị trí ban đầu
            const defaultLat = 10.7769;
            const defaultLng = 106.7009;

            const addressInput = document.getElementById("address");
            const searchResultBox = document.getElementById("searchResult");
            const latInput = document.getElementById("Latitude");
            const lngInput = document.getElementById("Longitude");

            // Khởi tạo bản đồ
            const map = L.map("map").setView([defaultLat, defaultLng], 13);

            L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
                attribution: "&copy; OpenStreetMap contributors",
                maxZoom: 19
            }).addTo(map);

            let marker = null;

            function setMarker(lat, lng) {
                if (marker) {
                    marker.setLatLng([lat, lng]);
                } else {
                    // draggable: true -> khách có thể kéo ghim để tinh chỉnh vị trí chính xác hơn
                    marker = L.marker([lat, lng], { draggable: true }).addTo(map);

                    marker.on("dragend", function() {
                        const pos = marker.getLatLng();
                        latInput.value = pos.lat;
                        lngInput.value = pos.lng;

                        // Reverse geocode: khách kéo ghim xong, tự động điền lại địa chỉ text cho khớp
                        reverseGeocode(pos.lat, pos.lng);
                    });
                }

                map.setView([lat, lng], 16);
                latInput.value = lat;
                lngInput.value = lng;
            }

            // Tìm kiếm địa chỉ qua Nominatim (API miễn phí của OpenStreetMap)
            let debounceTimer = null;

            addressInput.addEventListener("input", function() {
                const query = addressInput.value.trim();

                clearTimeout(debounceTimer);
                searchResultBox.innerHTML = "";

                if (query.length < 5) return; // tránh gọi API khi mới gõ vài ký tự

                // Debounce 500ms - tránh gọi API liên tục mỗi lần gõ 1 ký tự
                debounceTimer = setTimeout(function() {
                    searchAddress(query);
                }, 500);
            });

            async function searchAddress(query) {
                try {
                    // countrycodes=vn giới hạn kết quả trong Việt Nam cho chính xác hơn
                    const url = `https://nominatim.openstreetmap.org/search?format=json&addressdetails=1&countrycodes=vn&limit=5&q=${encodeURIComponent(query)}`;

                    const response = await fetch(url, {
                        headers: { "Accept-Language": "vi" }
                    });

                    const results = await response.json();

                    renderSearchResults(results);
                } catch (error) {
                    console.error("Lỗi tìm kiếm địa chỉ:", error);
                }
            }

            function renderSearchResults(results) {
                searchResultBox.innerHTML = "";

                if (results.length === 0) return;

                results.forEach(function(place) {
                    const item = document.createElement("button");
                    item.type = "button";
                    item.className = "list-group-item list-group-item-action";
                    item.textContent = place.display_name;

                    item.addEventListener("click", function() {
                        addressInput.value = place.display_name;
                        setMarker(parseFloat(place.lat), parseFloat(place.lon));
                        searchResultBox.innerHTML = "";
                    });

                    searchResultBox.appendChild(item);
                });
            }

            // Reverse geocode: từ toạ độ -> ra địa chỉ text (dùng khi khách kéo ghim)
            async function reverseGeocode(lat, lng) {
                try {
                    const url = `https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}`;

                    const response = await fetch(url, {
                        headers: { "Accept-Language": "vi" }
                    });

                    const result = await response.json();

                    if (result && result.display_name) {
                        addressInput.value = result.display_name;
                    }
                } catch (error) {
                    console.error("Lỗi reverse geocode:", error);
                }
            }

            // Nếu khách đã có Latitude/Longitude từ trước (model binding lúc validate lỗi, quay lại form),
            // hiển thị lại đúng marker cũ thay vì mặc định trung tâm thành phố
            const existingLat = latInput.value;
            const existingLng = lngInput.value;

            if (existingLat && existingLng) {
                setMarker(parseFloat(existingLat), parseFloat(existingLng));
            }

            // Nút "Dùng vị trí hiện tại" - tiện cho khách trên điện thoại
            const geoButton = document.createElement("button");
            geoButton.type = "button";
            geoButton.className = "btn btn-outline-secondary btn-sm mt-2";
            geoButton.textContent = "📍 Dùng vị trí hiện tại của tôi";

            geoButton.addEventListener("click", function() {
                if (!navigator.geolocation) {
                    alert("Trình duyệt không hỗ trợ định vị.");
                    return;
                }

                navigator.geolocation.getCurrentPosition(
                    function(position) {
                        setMarker(position.coords.latitude, position.coords.longitude);
                        reverseGeocode(position.coords.latitude, position.coords.longitude);
                    },
                    function() {
                        alert("Không thể lấy vị trí. Vui lòng nhập địa chỉ thủ công.");
                    }
                );
            });

            addressInput.insertAdjacentElement("afterend", geoButton);
        });
    </script>
}