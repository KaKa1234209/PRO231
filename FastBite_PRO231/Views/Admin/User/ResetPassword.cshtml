@model FastBite_PRO231.ViewModels.AdminResetPasswordViewModel

@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<section class="fbuser-page">
    <div class="fbuser-header">
        <div>
            <p>BẢO MẬT TÀI KHOẢN</p>

            <h1>Đặt lại mật khẩu</h1>

            <span>
                Tạo mật khẩu mới cho tài khoản @Model.UserName.
            </span>
        </div>

        <a asp-controller="Users"
           asp-action="Details"
           asp-route-id="@Model.UserId"
           class="fbuser-reset-button">

            ← Quay lại tài khoản
        </a>
    </div>

    <div class="fbuser-password-page">
        <section class="fbuser-form-card">
            <div class="fbuser-reset-profile">
                <div class="fbuser-large-avatar">
                    @{
                        var firstCharacter =
                            string.IsNullOrWhiteSpace(Model.FullName)
                                ? "U"
                                : Model.FullName
                                    .Substring(0, 1)
                                    .ToUpper();
                    }

                    @firstCharacter
                </div>

                <div>
                    <h2>@Model.FullName</h2>

                    <span>
                        @@@Model.UserName
                    </span>

                    <small>
                        Mã tài khoản: #@Model.UserId
                    </small>
                </div>
            </div>

            <form asp-controller="Users"
                  asp-action="ResetPassword"
                  method="post">

                @Html.AntiForgeryToken()

                <input asp-for="UserId"
                       type="hidden" />

                <input asp-for="UserName"
                       type="hidden" />

                <input asp-for="FullName"
                       type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>

                <div class="mb-3">
                    <label asp-for="NewPassword"
                           class="form-label fw-bold">
                    </label>

                    <div class="fbuser-password-wrap">
                        <input asp-for="NewPassword"
                               class="form-control"
                               id="newPassword"
                               autocomplete="new-password" />

                        <button type="button"
                                class="fbuser-show-password"
                                data-target="newPassword">

                            Hiện
                        </button>
                    </div>

                    <span asp-validation-for="NewPassword"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmPassword"
                           class="form-label fw-bold">
                    </label>

                    <div class="fbuser-password-wrap">
                        <input asp-for="ConfirmPassword"
                               class="form-control"
                               id="confirmNewPassword"
                               autocomplete="new-password" />

                        <button type="button"
                                class="fbuser-show-password"
                                data-target="confirmNewPassword">

                            Hiện
                        </button>
                    </div>

                    <span asp-validation-for="ConfirmPassword"
                          class="text-danger">
                    </span>
                </div>

                <div class="fbuser-security-warning">
                    Sau khi đổi mật khẩu, người dùng phải sử dụng mật khẩu
                    mới trong lần đăng nhập tiếp theo.
                </div>

                <div class="fbuser-form-actions">
                    <button type="submit"
                            class="fbuser-save-button"
                            onclick="return confirm('Xác nhận đặt lại mật khẩu cho tài khoản này?')">

                        Lưu mật khẩu mới
                    </button>

                    <a asp-controller="Users"
                       asp-action="Details"
                       asp-route-id="@Model.UserId"
                       class="fbuser-reset-button">

                        Hủy
                    </a>
                </div>
            </form>
        </section>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const buttons =
                document.querySelectorAll(".fbuser-show-password");

            buttons.forEach(function (button) {
                button.addEventListener("click", function () {
                    const targetId =
                        button.dataset.target;

                    const input =
                        document.getElementById(targetId);

                    if (!input) {
                        return;
                    }

                    const isPassword =
                        input.type === "password";

                    input.type =
                        isPassword ? "text" : "password";

                    button.textContent =
                        isPassword ? "Ẩn" : "Hiện";
                });
            });
        });
    </script>
}