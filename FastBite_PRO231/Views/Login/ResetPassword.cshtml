@model FastBite_PRO231.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<section class="fb-auth-page">
    <div class="container">
        <div class="fb-auth-card">
            <div class="fb-auth-title">
                <img src="~/images/fastbite-logo.jpg"
                     asp-append-version="true"
                     alt="FastBite Logo" />

                <h1>Đặt lại mật khẩu</h1>

                <p>
                    Xác thực OTP thành công. Vui lòng nhập mật khẩu mới cho tài khoản
                    <strong>@Model.Email</strong>.
                </p>
            </div>

            <form asp-controller="Login" asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="ResetToken" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3 fw-bold">
                </div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="fb-form-label"></label>

                    <input asp-for="NewPassword"
                           class="form-control fb-form-control"
                           placeholder="Nhập mật khẩu mới" />

                    <span asp-validation-for="NewPassword"
                          class="text-danger fb-validation">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="fb-form-label"></label>

                    <input asp-for="ConfirmPassword"
                           class="form-control fb-form-control"
                           placeholder="Nhập lại mật khẩu mới" />

                    <span asp-validation-for="ConfirmPassword"
                          class="text-danger fb-validation">
                    </span>
                </div>

                <button type="submit" class="btn fb-btn-primary w-100 mt-2">
                    Đặt lại mật khẩu
                </button>

                <div class="text-center mt-4">
                    <a asp-controller="Login"
                       asp-action="Login"
                       class="fb-auth-link">
                        ← Quay lại đăng nhập
                    </a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}