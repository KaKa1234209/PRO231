@model FastBite_PRO231.ViewModels.Login.LoginViewModel

@{
    ViewData["Title"] = "Đăng nhập";
}

<section class="fb-auth-page">
    <div class="container">
        <div class="fb-auth-card">
            <div class="fb-auth-title">
                <img src="~/images/fastbite-logo.jpg"
                     alt="FastBite" />

                <h1>Đăng nhập</h1>

                <p>
                    Đăng nhập để sử dụng các chức năng của FastBite.
                </p>
            </div>

            <form asp-controller="Login"
                  asp-action="Login"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3 fw-bold">
                </div>

                <div class="mb-3">
                    <label asp-for="UserName"
                           class="fb-form-label">
                        Tên đăng nhập
                    </label>

                    <input asp-for="UserName"
                           class="form-control fb-form-control"
                           autocomplete="username"
                           placeholder="Nhập tên đăng nhập" />

                    <span asp-validation-for="UserName"
                          class="text-danger fb-validation">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password"
                           class="fb-form-label">
                        Mật khẩu
                    </label>

                    <input asp-for="Password"
                           type="password"
                           class="form-control fb-form-control"
                           autocomplete="current-password"
                           placeholder="Nhập mật khẩu" />

                    <span asp-validation-for="Password"
                          class="text-danger fb-validation">
                    </span>
                </div>

                <button type="submit"
                        class="btn fb-btn-primary w-100 mt-2">
                    Đăng nhập
                </button>

                <div class="text-center mt-4">
                    <span>Chưa có tài khoản?</span>

                    <a class="fb-auth-link"
                       asp-controller="Login"
                       asp-action="Register">
                        Đăng ký ngay
                    </a>
                </div>

                <div class="text-center mt-2">
                    <a class="fb-auth-link"
                       asp-controller="Login"
                       asp-action="ForgotPassword">
                        Quên mật khẩu?
                    </a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}