@model FastBite_PRO231.ViewModels.Login.ChangePasswordViewModel

@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<section class="fb-auth-page">
    <div class="container">
        <div class="fb-auth-card">
            <div class="fb-auth-title">
                <img src="~/images/fastbite-logo.jpg"
                     asp-append-version="true"
                     alt="FastBite Logo" />

                <h1>Đổi mật khẩu</h1>

                <p>
                    Cập nhật mật khẩu mới để bảo vệ tài khoản.
                </p>
            </div>

            <form asp-controller="Login" asp-action="ChangePassword" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3 fw-bold">
                </div>

                <div class="mb-3">
                    <label asp-for="OldPassword" class="fb-form-label"></label>

                    <input asp-for="OldPassword"
                           class="form-control fb-form-control"
                           placeholder="Nhập mật khẩu hiện tại" />

                    <span asp-validation-for="OldPassword"
                          class="text-danger fb-validation">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="fb-form-label"></label>

                    <input asp-for="NewPassword"
                           class="form-control fb-form-control"
                           placeholder="Nhập mật khẩu mới" />

                    <span asp-validation-for="NewPassword"
                          class="text-danger fb-validation">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="fb-form-label"></label>

                    <input asp-for="ConfirmPassword"
                           class="form-control fb-form-control"
                           placeholder="Nhập lại mật khẩu mới" />

                    <span asp-validation-for="ConfirmPassword"
                          class="text-danger fb-validation">
                    </span>
                </div>

                <button type="submit" class="btn fb-btn-primary w-100 mt-2">
                    Cập nhật mật khẩu
                </button>

                <div class="text-center mt-4">
                    <a asp-controller="Home"
                       asp-action="Index"
                       class="fb-auth-link">
                        Quay về trang chủ
                    </a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}