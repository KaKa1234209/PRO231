@model Product

@{
    ViewData["Title"] = "Sửa sản phẩm";

    string? currentImageSrc = null;

    if (!string.IsNullOrWhiteSpace(Model.Image))
    {
        currentImageSrc = (Model.Image.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
                            Model.Image.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
            ? Model.Image
            : "/images/products/" + Model.Image;
    }
}

<section class="fb-admin-page">
    <div class="container">
        <div class="fb-form-card">
            <div class="fb-form-title">
                <h1>Sửa sản phẩm</h1>
                <p>Cập nhật thông tin món ăn của FastBite.</p>
            </div>

            <form asp-controller="Products"
                  asp-action="Edit"
                  asp-route-productid="@Model.ProductId"
                  method="post"
                  enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="ProductId" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3 fw-bold">
                </div>

                <div class="mb-3">
                    <label asp-for="ProductName" class="fb-form-label">
                        Tên sản phẩm
                    </label>

                    <input asp-for="ProductName"
                           class="form-control fb-form-control" />

                    <span asp-validation-for="ProductName"
                          class="text-danger fb-validation">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="CategoryId" class="fb-form-label">
                        Danh mục
                    </label>

                    <select asp-for="CategoryId"
                            asp-items="ViewBag.CategoryId"
                            class="form-select fb-form-control">
                        <option value="">-- Chọn danh mục --</option>
                    </select>

                    <span asp-validation-for="CategoryId"
                          class="text-danger fb-validation">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Price" class="fb-form-label">
                        Giá bán
                    </label>

                    <input asp-for="Price"
                           class="form-control fb-form-control" />

                    <span asp-validation-for="Price"
                          class="text-danger fb-validation">
                    </span>
                </div>

                <div class="mb-3">
                    <label class="fb-form-label">
                        Hình ảnh hiện tại
                    </label>

                    <div class="mb-2">
                        @if (currentImageSrc != null)
                        {
                            <img src="@currentImageSrc"
                                 class="fb-product-thumb"
                                 style="width: 100px; height: 100px; object-fit: cover; border-radius: 8px;"
                                 alt="@Model.ProductName" />
                        }
                        else
                        {
                            <div class="fb-product-placeholder"
                                 style="width: 100px; height: 100px; font-size: 40px;">
                                🍔
                            </div>
                        }
                    </div>

                    <label class="fb-form-label small text-muted">
                        Bỏ trống cả hai ô dưới nếu muốn giữ ảnh hiện tại — chỉ chọn 1 trong 2 nếu muốn đổi ảnh
                    </label>

                    <div class="mb-2">
                        <input type="file" name="imageFile" accept="image/*" class="form-control fb-form-control" />
                        <div class="small text-muted mt-1">Tải ảnh mới từ máy (JPG, PNG, WEBP, tối đa 5MB)</div>
                    </div>

                    <div class="text-center text-muted my-2">— hoặc —</div>

                    <div class="mb-2">
                        <input type="text"
                               name="imageUrl"
                               class="form-control fb-form-control"
                               placeholder="Dán link ảnh mới (bắt đầu bằng http:// hoặc https://)" />
                    </div>

                    <span asp-validation-for="Image"
                          class="text-danger fb-validation">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="fb-form-label">
                        Mô tả
                    </label>

                    <textarea asp-for="Description"
                              rows="4"
                              class="form-control fb-form-control"></textarea>

                    <span asp-validation-for="Description"
                          class="text-danger fb-validation">
                    </span>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="Status" class="form-check-input" />

                    <label asp-for="Status" class="form-check-label fw-bold">
                        Đang bán
                    </label>
                </div>

                <div class="d-flex gap-2 justify-content-center mt-4">
                    <button type="submit" class="btn fb-btn-primary">
                        Cập nhật
                    </button>

                    <a class="btn fb-btn-outline"
                       asp-controller="Products"
                       asp-action="Index">
                        Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
